+#define ROR(x,n) (((x) >> (n)) | ((x) << (32U-(n))))
+#define SMALL0(x) (ROR(x,7)^ROR(x,18)^((x)>>3))
+#define SMALL1(x) (ROR(x,17)^ROR(x,19)^((x)>>10))
