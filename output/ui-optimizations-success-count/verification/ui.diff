+/* 目录仅缓存当前页的六个名称；浏览不读取文件正文，也不更改有效选择。
+ * locate非0时定位当前文件；后续跨页按g_file_first填充，文件数不受缓存大小限制。 */
+static uint8_t scan_firmware_page(uint8_t locate)
+{
+    uint8_t ret;
+    g_file_count = 0;
+    memset(g_file_list, 0, sizeof(g_file_list));
+    if(locate) { g_file_index = 0; g_file_first = 0; }
+    if(f_opendir(&DirInfo, "0:/download/bin") != FR_OK) goto directory_error;
+    while((ret = f_readdir(&DirInfo, &FileInfo)) == FR_OK && FileInfo.fname[0])
+    {
+        if(!selectable_firmware(FileInfo.fname, FileInfo.fattrib)) continue;
+        if(locate && !strcmp((const char *)app_data.bin_name, FileInfo.fname))
+            g_file_index = g_file_count;
+        if(g_file_count >= g_file_first && g_file_count - g_file_first < FILE_LIST_ROWS)
+            strcpy(g_file_list[g_file_count - g_file_first], FileInfo.fname);
+        g_file_count++;
+    }
+    if(f_closedir(&DirInfo) != FR_OK) ret = FR_DISK_ERR;
+    if(ret != FR_OK) goto directory_error;
+    g_file_error = NULL;
+    return 1;
+directory_error:
+    g_file_count = 0;
+    memset(g_file_list, 0, sizeof(g_file_list));
+    g_file_error = "\xC4\xBF\xC2\xBC\xB6\xC1\xC8\xA1\xCA\xA7\xB0\xDC";
+    return 0;
+}
