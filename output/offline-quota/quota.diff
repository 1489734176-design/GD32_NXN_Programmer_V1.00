-# ─── USB Protocol Constants ────────────────────────────────────────────────────
-
-VID = 0x28E9
-PID = 0x128A
-CUSTOMBULK_INTERFACE = 1
-EP_OUT = 0x02
-EP_IN = 0x82
-PACKET_SIZE = 64
-MAX_DATA = 56
-TIMEOUT = 5000
-
-CMD_LIST_DIR    = 0x01
-CMD_OPEN_WRITE  = 0x02
-CMD_WRITE_DATA  = 0x03
-CMD_CLOSE_FILE  = 0x04
-CMD_OPEN_READ   = 0x05
-CMD_READ_DATA   = 0x06
-CMD_DELETE_FILE = 0x07
-CMD_MKDIR       = 0x08
-CMD_GET_STATUS  = 0x09
-CMD_RENAME      = 0x0A
-CMD_STAGE_ALGORITHM = 0x0B
-CMD_PREPARE_DOWNLOAD = 0x0C
-
-STATUS_OK   = 0x00
-STATUS_ERR  = 0x01
-STATUS_BUSY = 0x02
-STATUS_EOF  = 0x03
