+            self._navigate_remote("/")
+        else:
+            self.lbl_status_icon.setStyleSheet("color: #e74c3c; font-size: 16px;")
+            self.lbl_status_text.setText("未连接")
+            self.statusBar().showMessage(f"连接失败: {msg}")
+        self._update_toolbar_state()
